# For BusyBox/SysV init: source this file in the backend's init script before
# starting node, e.g.  set -a; . /etc/default/das-backend; set +a
DAS_MODE=hotfix
DAS_WORKERS=0
DAS_WORKER_NICE=10
DAS_WORKER_HEAP_MB=96
DAS_WORKER_YOUNG_MB=8
DAS_GZIP_LEVEL=1
DAS_SPECTRUM_IDLE_MS=15000
DAS_SPECTRUM_MIN_INTERVAL_MS=0
DAS_BLOCK_WARN_MS=200
UV_THREADPOOL_SIZE=2
MALLOC_ARENA_MAX=2
NODE_OPTIONS=--max-old-space-size=256
