# Minimal MIME map for the DAS web UI (the device may use /etc/nginx/mime.types instead).
types {
    text/html                             html htm;
    text/css                              css;
    text/plain                            txt;
    application/javascript                js mjs;
    application/json                      json map;
    application/manifest+json             webmanifest;
    image/svg+xml                         svg svgz;
    image/png                             png;
    image/jpeg                            jpeg jpg;
    image/x-icon                          ico;
    font/woff                             woff;
    font/woff2                            woff2;
    application/wasm                      wasm;
}
