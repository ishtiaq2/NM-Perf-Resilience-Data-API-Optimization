[Unit]
Description=DAS core API (heartbeat, config, everything light)
PartOf=das.target
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
Slice=das.slice
User=das
Group=das
WorkingDirectory=/opt/das-web
Environment=NODE_ENV=production
Environment=UV_THREADPOOL_SIZE=2
Environment=MALLOC_ARENA_MAX=2
EnvironmentFile=-/etc/default/das-web
Restart=always
RestartSec=1
# Sandboxing: the services only need their sockets and read-only code.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/das
Environment=LISTEN=unix:/run/das/core-api.sock
Environment=DAS_UPSTREAM_SPECTRUM=unix:/run/das/spectrum.sock
Environment=DAS_UPSTREAM_TELEMETRY=unix:/run/das/telemetry.sock
Environment=NODE_OPTIONS=--max-old-space-size=96
ExecStart=/usr/bin/node services/core-api/server.js
# Highest priority: heartbeat and configuration writes must always get the CPU.
Nice=-5
CPUWeight=400
MemoryMax=128M

[Install]
WantedBy=das.target
