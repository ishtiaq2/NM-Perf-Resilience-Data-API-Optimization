# /etc/default/das-edge - environment for das-edge.service (every flag has a DAS_* variable).

# One origin for the browser: HTTPS with HTTP/2 (WebSocket upgrades use HTTP/1.1 automatically).
DAS_LISTEN=:443
DAS_TLS_CERT=/etc/das-edge/tls/cert.pem
DAS_TLS_KEY=/etc/das-edge/tls/key.pem

# The Angular build (dist/browser). Without it the built-in status page is served.
DAS_WEB_ROOT=/opt/das-edge/ui

# Strangler fig: everything the edge does not implement goes to the existing
# Node.js backend (keep it running, bound to a local socket or 127.0.0.1).
DAS_LEGACY=unix:/run/das/core-api.sock
# Configuration stays with the legacy backend until it is migrated.
DAS_CONFIG=legacy

# Remote Nodes stream their state here (Connect over h2c) on the fiber management network.
# DAS_INGEST_LISTEN=10.10.0.1:9090
# 0 = no simulator: telemetry comes from real nodes (ingest) only.
DAS_NODES=0

# Spectrum analyzer
DAS_SPECTRUM_POINTS=50001
DAS_SPECTRUM_MAX_SESSIONS=8
DAS_MAX_WS_CLIENTS=64

# Heavy work (encoding, compression): threads and their nice value.
# DAS_HEAVY_WORKERS=0
# DAS_HEAVY_NICE=10

DAS_LOG_FORMAT=json
DAS_LOG=info
# DAS_PPROF=127.0.0.1:6060
