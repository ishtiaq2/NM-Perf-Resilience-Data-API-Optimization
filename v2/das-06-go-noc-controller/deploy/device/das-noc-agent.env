# /etc/default/das-noc-agent (mode 0600: the token identifies this Master Unit)
NOC_URL=wss://noc.example.com/uplink/v1
# Issued per site:  noc token -kind site -subject S00042 -tenant airport-01
NOC_TOKEN=v1.site.S00042.airport-01.REPLACE-ME
# The backend's own API on this Master Unit: where the Angular UI's
# /api/volatile-data comes from (the Node.js app, or the das-02 gateway).
LOCAL_API=http://127.0.0.1:80
POLL_MS=5000
SITE_NAME=Terminal 2
SITE_VENUE=Airport North
SITE_REGION=north
SITE_FW=3.1.4
