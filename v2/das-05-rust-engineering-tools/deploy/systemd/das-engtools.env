# /etc/default/das-engtools - environment for das-engtools.service.
# Every flag has a DAS_* variable (das-engtools --help).

# --- Profile A (recommended): inside the das-02 nginx gateway ------------------
# das-engtools takes over the spectrum-service socket; nginx keeps TLS, HTTP/2 and
# the UI files, core-api keeps login/config (deploy/nginx/das02-engtools-locations.conf).
DAS_LISTEN=unix:/run/das/spectrum.sock
DAS_SIDECAR=1
DAS_LEGACY=unix:/run/das/core-api.sock

# --- Profile B: front mode, no gateway on the device ----------------------------
# das-engtools owns the public HTTP port; the unchanged Node.js application moves to
# 127.0.0.1:8081 (one line in its own service file) and gets everything else.
#DAS_LISTEN=0.0.0.0:80
#DAS_LEGACY=http://127.0.0.1:8081
#DAS_SIDECAR=0

# Spectrum analyzer
DAS_SPECTRUM_POINTS=50001
DAS_SPECTRUM_MAX_SESSIONS=8
DAS_SPECTRUM_IDLE_MS=15000
DAS_MAX_WS_CLIENTS=64

# DSP threads (parsing, FFT, encoding, compression): 0 = one per spare core.
DAS_DSP_WORKERS=0
DAS_DSP_NICE=10
DAS_DSP_QUEUE=64

DAS_LOG_FORMAT=json
RUST_LOG=info
